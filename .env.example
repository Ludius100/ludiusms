# Ludius MS example configuration
# Copy to .env and fill in your local values.
# Never commit the real .env file.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
TZ=Europe/Warsaw

# URL/origin of the frontend that is allowed to call dashboard-api.
# Example for a local/Tailscale install:
HOMEPAGE_ORIGIN=http://YOUR_SERVER_IP:3000

# -----------------------------------------------------------------------------
# Jellyfin
# -----------------------------------------------------------------------------
# Jellyfin API endpoint reachable from dashboard-api.
JELLYFIN_URL=http://127.0.0.1:8096

# Path inside the dashboard-api container to the Jellyfin API key file.
# The real key should be created locally by the installer/first-run wizard.
JELLYFIN_API_KEY_FILE=/run/secrets/jellyfin_api_key

# -----------------------------------------------------------------------------
# qBittorrent
# -----------------------------------------------------------------------------
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME=your_qbittorrent_username
QBITTORRENT_PASSWORD=your_qbittorrent_password

# -----------------------------------------------------------------------------
# Storage / media
# -----------------------------------------------------------------------------
# Host path mounted into dashboard-api as /nas.
NAS_HOST_PATH=/srv/storage/NAS

# Library paths below are paths INSIDE the dashboard-api container.
# They intentionally default to the current Ludius MS library layout.
LIBRARY_MOVIES_PATH=/nas/Filmy
LIBRARY_SERIES_PATH=/nas/Seriale
LIBRARY_ANIME_PATH=/nas/Anime
LIBRARY_ANIME_MOVIES_PATH=/nas/Anime Filmy
LIBRARY_DOWNLOADS_PATH=/nas/Downloads
