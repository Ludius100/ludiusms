# Ludius MS example installation configuration
# Copy this file to dashboard-api/.env and adjust it for your server.
# Never commit the real .env file.

# -----------------------------------------------------------------------------
# General / API runtime
# -----------------------------------------------------------------------------
TZ=Europe/Warsaw

# Address Gunicorn should listen on.
# Keep 127.0.0.1 for local-only access or use an address reachable by your frontend.
LMS_BIND=127.0.0.1:8090
LMS_WORKERS=1
LMS_THREADS=4

# Frontend origin allowed to call the LMS API.
HOMEPAGE_ORIGIN=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Modules
# -----------------------------------------------------------------------------
ENABLE_JELLYFIN=true
ENABLE_QBITTORRENT=true

# -----------------------------------------------------------------------------
# Jellyfin
# -----------------------------------------------------------------------------
JELLYFIN_URL=http://127.0.0.1:8096

# Host file mounted into dashboard-api and its path inside the container.
JELLYFIN_API_KEY_HOST_PATH=./secrets/jellyfin_api_key
JELLYFIN_API_KEY_FILE=/run/secrets/jellyfin_api_key

# -----------------------------------------------------------------------------
# qBittorrent
# -----------------------------------------------------------------------------
QBITTORRENT_URL=http://127.0.0.1:8080

# qBittorrent credentials are intentionally kept in:
# dashboard-api/secrets/qbittorrent.env
# with:
# QBITTORRENT_USERNAME=...
# QBITTORRENT_PASSWORD=...

# -----------------------------------------------------------------------------
# Optional service status checks
# -----------------------------------------------------------------------------
# Leave blank to omit the service from GET /api/status.
GDRIVE_URL=
KUMA_URL=
NTFY_URL=

# -----------------------------------------------------------------------------
# Storage / NAS
# -----------------------------------------------------------------------------
# Host path and the mount point visible inside dashboard-api.
NAS_HOST_PATH=/srv/storage/NAS
NAS_ROOT=/nas

# Ownership/modes applied to media created by LMS.
NAS_UID=1002
NAS_GID=1003
NAS_DIRECTORY_MODE=2770
NAS_FILE_MODE=0660

# Persistent LMS runtime state.
LMS_DATA_HOST_PATH=./data
LMS_DATA_DIR=/app/data

# Media library paths INSIDE dashboard-api.
# Empty values fall back to folders under NAS_ROOT.
LIBRARY_MOVIES_PATH=
LIBRARY_SERIES_PATH=
LIBRARY_ANIME_PATH=
LIBRARY_ANIME_MOVIES_PATH=
LIBRARY_DOWNLOADS_PATH=
